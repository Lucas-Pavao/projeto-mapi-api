{
  "uid": "mapi-jvm-recursos",
  "title": "MAPI - JVM e Recursos",
  "description": "Saúde de infraestrutura do processo: memória, CPU, GC, threads e pool de conexões do banco.",
  "tags": ["mapi", "jvm", "infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Heap Memory",
      "description": "Memória de heap usada vs. máxima disponível para a JVM.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{job=\"mapi-api\",area=\"heap\"})",
          "legendFormat": "usada"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_max_bytes{job=\"mapi-api\",area=\"heap\"})",
          "legendFormat": "máxima"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU do processo",
      "description": "Uso de CPU pelo processo da API.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_cpu_usage{job=\"mapi-api\"}",
          "legendFormat": "process_cpu_usage"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pausas de Garbage Collection",
      "description": "Tempo total gasto em pausas de GC por segundo, por tipo de coleta.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"mapi-api\"}[$__rate_interval])) by (action)",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Threads da JVM",
      "description": "Threads vivas vs. pico histórico.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_live_threads{job=\"mapi-api\"}",
          "legendFormat": "vivas"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_peak_threads{job=\"mapi-api\"}",
          "legendFormat": "pico"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pool de conexões do banco (HikariCP)",
      "description": "Conexões ativas, ociosas e o limite máximo configurado do pool.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_active{job=\"mapi-api\"}",
          "legendFormat": "ativas"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_idle{job=\"mapi-api\"}",
          "legendFormat": "ociosas"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_max{job=\"mapi-api\"}",
          "legendFormat": "máximo"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "description": "Tempo desde a última subida do processo.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_uptime_seconds{job=\"mapi-api\"}",
          "legendFormat": "uptime"
        }
      ]
    }
  ]
}
