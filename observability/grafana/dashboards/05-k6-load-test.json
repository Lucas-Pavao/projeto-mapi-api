{
  "uid": "mapi-k6-load-test",
  "title": "MAPI - Teste de Carga (k6)",
  "description": "Métricas do lado do cliente durante uma execução do k6 (loadtest/stress-test.js), enviadas via remote-write direto pro Prometheus. Só populado enquanto 'docker compose --profile loadtest run k6' está rodando.",
  "tags": ["mapi", "k6", "loadtest"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "VUs ativos",
      "description": "Usuários virtuais simultâneos configurados nos stages do script.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "k6_vus", "legendFormat": "VUs" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requisições/s por status",
      "description": "Throughput gerado pelo teste, quebrado por código de resposta HTTP.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(k6_http_reqs_total[$__rate_interval])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Taxa de erro",
      "description": "Fração de requisições marcadas como falha pelo k6 (http_req_failed) e de checks que falharam.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "k6_http_req_failed_rate", "legendFormat": "requests falhas" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1 - k6_checks_rate", "legendFormat": "checks falhos" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência por endpoint (p95)",
      "description": "Percentil 95 do tempo de resposta, por endpoint (tag 'name' setada no script). Weather/marine incluem round-trip pra Open-Meteo quando o cache está frio.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "k6_http_req_duration_p95",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Resumo por endpoint (instantâneo)",
      "description": "Latência média/p95 e volume de requisições por endpoint, no instante atual.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "format": "table",
          "expr": "k6_http_req_duration_avg"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "instant": true,
          "format": "table",
          "expr": "k6_http_req_duration_p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Iterações/s",
      "description": "Ritmo em que os VUs completam um ciclo inteiro do script (todos os grupos de requests).",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "iops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "rate(k6_iterations_total[$__rate_interval])", "legendFormat": "iterações/s" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requisições/s por endpoint",
      "description": "Distribuição do tráfego gerado entre os endpoints exercitados pelo script.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(k6_http_reqs_total[$__rate_interval])) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
