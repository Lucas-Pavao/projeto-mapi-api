@@ -0,0 +1,19 @@
+import React from 'react';
+import { ShieldCheck, TriangleAlert, OctagonAlert, CircleHelp } from 'lucide-react';
+import type { RiskLevel } from '../schemas/floodPointResponse.schema';
+
+const ICONS: Record<RiskLevel, React.ComponentType<{ className?: string; 'aria-hidden'?: boolean }>> = {
+  LOW: ShieldCheck,
+  MEDIUM: TriangleAlert,
+  HIGH: OctagonAlert,
+  UNKNOWN: CircleHelp,
+};
+
+/**
+ * Ícone por nível. Forma distinta por classe (escudo, triângulo, octógono, interrogação) para
+ * que o risco não dependa só de cor (WCAG 1.4.1). Decorativo: o nome acessível vem do pai.
+ */
+export const RiskIcon: React.FC<{ level: RiskLevel | null | undefined; className?: string }> = ({ level, className }) => {
+  const Icon = ICONS[level ?? 'UNKNOWN'] ?? CircleHelp;
+  return <Icon className={className} aria-hidden={true} />;
+};
diff --color -ruN src/features/map/components/RiskLegend.test.tsx /home/lucas/Documents/Projetos/MAPI/projeto-mapi-front/src/features/map/components/RiskLegend.test.tsx
--- src/features/map/components/RiskLegend.test.tsx	1969-12-31 21:00:00.000000000 -0300
+++ /home/lucas/Documents/Projetos/MAPI/projeto-mapi-front/src/features/map/components/RiskLegend.test.tsx	2026-10-10 10:43:56.927279083 -0300
@@ -0,0 +1,30 @@
+import { describe, it, expect, afterEach } from 'vitest';
+import { render, screen, cleanup, fireEvent, within } from '@testing-library/react';
+import { RiskLegend } from './RiskLegend';
+
+afterEach(cleanup);
+
+describe('RiskLegend', () => {
+  it('lista os 4 estados com rótulo em português e significado operacional', () => {
+    render(<RiskLegend />);
+    const items = screen.getAllByRole('listitem');
+    expect(items.map((i) => i.getAttribute('data-risk'))).toEqual(['LOW', 'MEDIUM', 'HIGH', 'UNKNOWN']);
+    for (const label of ['Baixo', 'Moderado', 'Alto', 'Previsão indisponível']) {
+      expect(screen.getByText(label)).toBeInTheDocument();
+    }
+    expect(within(items[3]).getByText(/não significa risco baixo/)).toBeInTheDocument();
+    expect(within(items[2]).getByText(/não confirma alagamento/)).toBeInTheDocument();
+  });
+  it('não promete o que o modelo não faz (sem "garante", "certeza", "evacuar")', () => {
+    const { container } = render(<RiskLegend />);
+    expect(container.textContent).not.toMatch(/garant|certeza|evacu/i);
+  });
+  it('cabeçalho recolhe e expande o corpo (aria-expanded)', () => {
+    render(<RiskLegend />);
+    const toggle = screen.getByRole('button', { name: /Legenda de risco/ });
+    expect(toggle).toHaveAttribute('aria-expanded', 'true');
+    fireEvent.click(toggle);
+    expect(toggle).toHaveAttribute('aria-expanded', 'false');
+    expect(document.getElementById('risk-legend-body')).toHaveAttribute('hidden');
+  });
+});
diff --color -ruN src/features/map/components/RiskLegend.tsx /home/lucas/Documents/Projetos/MAPI/projeto-mapi-front/src/features/map/components/RiskLegend.tsx
--- src/features/map/components/RiskLegend.tsx	1969-12-31 21:00:00.000000000 -0300
