+++ src/features/map/utils/terrain.ts	2026-10-10 10:58:36.234988032 -0300
@@ -0,0 +1,56 @@
+import maplibregl from 'maplibre-gl';
+import { cogProtocol, colorScale } from '@geomatico/maplibre-cog-protocol';
+
+/**
+ * Camada de terreno (ADR 0008, C1): COG em EPSG:3857 com a cota BRUTA do MDT do PE3D, lido por
+ * range requests; paleta e limites ficam aqui, no cliente. ADR 0009: só hipsometria (cota
+ * relativa do MDT, datum não confirmado). Nada nesta camada compara cota com nível de água.
+ */
+export const TERRAIN_COG_PATH = '/terrain/terrain_3857.tif';
+export const TERRAIN_SOURCE_ID = 'terrain-hypsometry-source';
+export const TERRAIN_LAYER_ID = 'terrain-hypsometry-layer';
+export const TERRAIN_OPACITY = 0.65;
+
+/** Sequencial amarelo->roxo (CARTOColors Sunset), contínua. Não sugere água; contraste visível nas cotas baixas. */
+export const TERRAIN_COLOR_SCHEME = 'CartoSunset';
+export const TERRAIN_MIN_M = 0;
+/** Acima de TERRAIN_MAX_M a cor satura (a legenda diz "30 m ou mais"). */
+export const TERRAIN_MAX_M = 30;
+/** Cotas rotuladas na legenda (m). */
+export const TERRAIN_LEGEND_TICKS_M = [0, 5, 10, 20, 30] as const;
+
+let protocolRegistered = false;
+
+/** Registra o protocolo `cog://` uma única vez (addProtocol é global do maplibre-gl). */
+export function ensureCogProtocol(): void {
+  if (protocolRegistered) return;
+  maplibregl.addProtocol('cog', cogProtocol);
+  protocolRegistered = true;
+}
+
+export function terrainSourceUrl(origin: string = window.location.origin): string {
+  return `cog://${origin}${TERRAIN_COG_PATH}#color:${TERRAIN_COLOR_SCHEME},${TERRAIN_MIN_M},${TERRAIN_MAX_M},c`;
+}
+
+export interface TerrainLegendStop {
+  valueM: number;
+  /** `rgb(r, g, b)` vindo da MESMA escala que a camada usa para desenhar. */
+  color: string;
+}
+
+export function terrainLegendStops(): TerrainLegendStop[] {
+  const scale = colorScale({
+    colorScheme: TERRAIN_COLOR_SCHEME,
+    min: TERRAIN_MIN_M,
+    max: TERRAIN_MAX_M,
+    isContinuous: true,
+    isReverse: false,
+  }) as (v: number) => [number, number, number];
+  return TERRAIN_LEGEND_TICKS_M.map((valueM) => {
+    const [r, g, b] = scale(valueM);
+    return { valueM, color: `rgb(${Math.round(r)}, ${Math.round(g)}, ${Math.round(b)})` };
+  });
+}
+
