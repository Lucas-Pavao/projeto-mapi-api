+import React from 'react';
+import { terrainLegendStops, TERRAIN_MAX_M } from '../utils/terrain';
+
+/** Legenda de cotas da hipsometria: faixa de cor gerada da mesma escala da camada. */
+export const TerrainLegend: React.FC = () => {
+  const stops = terrainLegendStops();
+  const gradient = `linear-gradient(to right, ${stops
+    .map((s) => `${s.color} ${(s.valueM / TERRAIN_MAX_M) * 100}%`)
+    .join(', ')})`;
+  return (
+    <div data-testid="terrain-legend" className="px-3 pb-3 pt-1">
+      <div
+        role="img"
+        aria-label={`Escala de cota do terreno, de ${stops[0].valueM} a ${TERRAIN_MAX_M} metros ou mais`}
+        className="h-3 w-full rounded border border-white/20"
+        style={{ backgroundImage: gradient }}
+      />
+      <ol className="mt-1 flex justify-between text-2xs tabular-nums text-zinc-300" aria-hidden="true">
+        {stops.map((s) => (
+          <li key={s.valueM}>{s.valueM === TERRAIN_MAX_M ? `${s.valueM}+` : s.valueM}</li>
+        ))}
+      </ol>
+      <p className="mt-1 text-2xs leading-snug text-zinc-300">Cota do terreno (m).</p>
+      <p className="mt-1 text-2xs leading-snug text-zinc-400">
+        Datum não confirmado — cotas relativas. Fonte: MDT PE3D, voo de 2016.
+      </p>
+    </div>
+  );
+};
