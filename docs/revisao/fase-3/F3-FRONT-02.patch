@@ -15,18 +15,17 @@
         add_header Cache-Control "public, immutable";
     }
 
-    # Terreno (ADR 0008, C1): COG estático lido pelo navegador por range requests. O .tif NÃO está
-    # na imagem (public/terrain está no .dockerignore): monte o volume em /usr/share/nginx/terrain
-    # (terrain_3857.tif + terrain_manifest.json, gerados por `tools/terreno/run.sh cog3857`).
-    # O nginx atende "Range: bytes=a-b" em arquivo estático por padrão (responde 206 e
-    # "Accept-Ranges: bytes"); aqui só se garante o que não pode acontecer: gzip no .tif
-    # (gzip_types já não o inclui; "gzip off" deixa explícito) tiraria o suporte a Range.
-    # ETag/Last-Modified do arquivo continuam ligados, então a revalidação (304) é barata.
+    # Terreno (ADR 0008, C3): PMTiles estático (tiles PNG já coloridos) lido pelo navegador por
+    # range requests. O .pmtiles NÃO está na imagem (public/terrain está no .dockerignore): monte o
+    # volume em /usr/share/nginx/terrain (terrain_hypsometry.pmtiles + terrain_manifest.json,
+    # gerados por `tools/terreno/run.sh tiles`). O nginx atende "Range: bytes=a-b" em arquivo
+    # estático por padrão (206 + "Accept-Ranges: bytes"); "gzip off" garante que nada recomprime o
+    # arquivo (tiraria o Range). ETag/Last-Modified continuam ligados (revalidação 304 barata).
     location /terrain/ {
         alias /usr/share/nginx/terrain/;
         gzip off;
         add_header Cache-Control "public, max-age=3600, must-revalidate";
-        types { image/tiff tif tiff; application/json json; }
+        types { application/octet-stream pmtiles; application/json json; }
     }
 
