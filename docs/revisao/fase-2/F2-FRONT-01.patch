+++ front-after/src/features/map/utils/datetime.ts	2026-10-10 09:33:47.263654362 -0300
@@ -0,0 +1,19 @@
+const recifeFormatter = new Intl.DateTimeFormat('pt-BR', {
+  timeZone: 'America/Recife',
+  day: '2-digit',
+  month: '2-digit',
+  year: 'numeric',
+  hour: '2-digit',
+  minute: '2-digit',
+});
+
+/**
+ * Utilitário único de exibição de instantes em America/Recife (ADR 0001/0007).
+ * Aceita ISO-8601 (com `Z` ou offset). Ausente ou inválido → null, nunca "Invalid Date".
+ */
+export function formatRecife(iso: string | null | undefined): string | null {
+  if (!iso) return null;
+  const date = new Date(iso);
+  if (Number.isNaN(date.getTime())) return null;
+  return recifeFormatter.format(date).replace(',', '');
+}
diff --color -ruN front-before/src/features/map/utils/risk.test.ts front-after/src/features/map/utils/risk.test.ts
--- front-before/src/features/map/utils/risk.test.ts	1969-12-31 21:00:00.000000000 -0300
+++ front-after/src/features/map/utils/risk.test.ts	2026-10-10 09:33:47.261164928 -0300
@@ -0,0 +1,54 @@
+import { describe, it, expect } from 'vitest';
+import { RISK_LEVELS } from '../schemas/floodPointResponse.schema';
+import { getRiskVisual, formatProbability, degradationText } from './risk';
+import { formatRecife } from './datetime';
+
+describe('getRiskVisual', () => {
+  it('cobre todos os níveis do enum, com rótulo e cor próprios', () => {
+    const visuals = RISK_LEVELS.map((l) => getRiskVisual(l));
+    expect(new Set(visuals.map((v) => v.hex)).size).toBe(RISK_LEVELS.length);
+    expect(new Set(visuals.map((v) => v.label)).size).toBe(RISK_LEVELS.length);
+  });
+
+  it('UNKNOWN é neutro: cor distinta das de risco e sem porcentagem', () => {
+    const unknown = getRiskVisual('UNKNOWN');
+    for (const l of ['LOW', 'MEDIUM', 'HIGH'] as const) {
+      expect(getRiskVisual(l).hex).not.toBe(unknown.hex);
+      expect(getRiskVisual(l).showsProbability).toBe(true);
+    }
+    expect(unknown.showsProbability).toBe(false);
+    expect(unknown.label).toBe('Previsão indisponível');
+  });
+
+  it('ausente ou valor inesperado em runtime cai no estado neutro', () => {
+    expect(getRiskVisual(undefined)).toEqual(getRiskVisual('UNKNOWN'));
+    expect(getRiskVisual('CRITICAL' as never)).toEqual(getRiskVisual('UNKNOWN'));
+  });
+});
+
+describe('formatProbability', () => {
+  it('formata risco conhecido', () => expect(formatProbability('MEDIUM', 0.42)).toBe('42%'));
+  it('UNKNOWN nunca mostra porcentagem, mesmo com 0.0 do backend antigo', () => {
+    expect(formatProbability('UNKNOWN', 0.0)).toBeNull();
+    expect(formatProbability('UNKNOWN', 0.7)).toBeNull();
+  });
+  it('probabilidade null não renderiza', () => expect(formatProbability('LOW', null)).toBeNull());
+});
+
+describe('degradationText', () => {
+  it('texto fixo por motivo e fallback', () => {
+    expect(degradationText('AI_TIMEOUT')).toMatch(/demorou/);
+    expect(degradationText(null)).toBe('motivo não informado');
+    expect(degradationText(undefined)).toBe('motivo não informado');
+  });
+});
+
+describe('formatRecife', () => {
+  it('converte UTC para America/Recife (UTC-3)', () => {
+    expect(formatRecife('2026-10-10T15:30:00Z')).toBe('10/10/2026 12:30');
+  });
+  it('ausente ou inválido → null', () => {
+    expect(formatRecife(null)).toBeNull();
+    expect(formatRecife('xx')).toBeNull();
+  });
+});
diff --color -ruN front-before/src/features/map/utils/risk.ts front-after/src/features/map/utils/risk.ts
--- front-before/src/features/map/utils/risk.ts	1969-12-31 21:00:00.000000000 -0300
+++ front-after/src/features/map/utils/risk.ts	2026-10-10 09:33:47.258681514 -0300
@@ -0,0 +1,64 @@
+import type { DegradationReason, RiskLevel } from '../schemas/floodPointResponse.schema';
+
+/** Visual de um nível de risco. UNKNOWN usa cinza neutro, fora da paleta de risco. */
+export interface RiskVisual {
+  label: string;
+  /** Cor hex (círculo do mapa). */
+  hex: string;
+  /** Marcador: fundo e anel de pulso. */
+  bg: string;
+  ping: string;
+  /** Texto/ícone, borda, fundo suave e cabeçalho (card de detalhe). */
+  text: string;
+  border: string;
+  softBg: string;
+  header: string;
+  shadow: string;
+  /** false em UNKNOWN: nunca exibir porcentagem. */
+  showsProbability: boolean;
+}
+
+const UNKNOWN_VISUAL: RiskVisual = { label: 'Previsão indisponível', hex: '#71717a', bg: 'bg-zinc-500', ping: 'bg-zinc-400', text: 'text-zinc-400', border: 'border-zinc-500/30', softBg: 'bg-zinc-500/5', header: 'bg-zinc-600/80', shadow: 'shadow-black/20', showsProbability: false };
+
+/** Único mapeamento risco→visual do app. `never` garante exaustividade em compilação. */
+export function getRiskVisual(level: RiskLevel | undefined | null): RiskVisual {
+  const l: RiskLevel = level ?? 'UNKNOWN';
+  switch (l) {
+    case 'HIGH':
+      return { label: 'Alto', hex: '#f97316', bg: 'bg-orange-500', ping: 'bg-orange-400', text: 'text-orange-500', border: 'border-orange-500/30', softBg: 'bg-orange-500/5', header: 'bg-orange-600/80', shadow: 'shadow-orange-500/20', showsProbability: true };
+    case 'MEDIUM':
+      return { label: 'Moderado', hex: '#f59e0b', bg: 'bg-amber-500', ping: 'bg-amber-400', text: 'text-amber-500', border: 'border-amber-500/30', softBg: 'bg-amber-500/5', header: 'bg-amber-600/80', shadow: 'shadow-amber-500/20', showsProbability: true };
+    case 'LOW':
+      return { label: 'Baixo', hex: '#10b981', bg: 'bg-emerald-500', ping: 'bg-emerald-400', text: 'text-emerald-500', border: 'border-emerald-500/30', softBg: 'bg-emerald-500/5', header: 'bg-emerald-600/80', shadow: 'shadow-emerald-500/20', showsProbability: true };
+    case 'UNKNOWN':
+      return UNKNOWN_VISUAL;
+    default: {
+      // Exaustividade em compilação; em runtime, valor inesperado cai no estado neutro.
+      const _exhaustive: never = l;
+      void _exhaustive;
+      return UNKNOWN_VISUAL;
+    }
+  }
+}
+
+const DEGRADATION_TEXT: Record<DegradationReason, string> = {
+  INSUFFICIENT_DATA: 'dados insuficientes para prever',
+  AI_TIMEOUT: 'o modelo demorou demais para responder',
+  AI_UNAVAILABLE: 'o modelo está fora do ar',
+  AI_ERROR: 'erro no modelo de previsão',
+};
+
+/** Texto fixo, em português, por motivo de degradação. Ausente → "motivo não informado". */
+export function degradationText(reason: DegradationReason | null | undefined): string {
+  if (!reason) return 'motivo não informado';
+  return DEGRADATION_TEXT[reason] ?? 'motivo não informado';
+}
+
+/** "42%" ou null. UNKNOWN e probabilidade null nunca geram porcentagem (ADR 0007 §6). */
+export function formatProbability(
+  level: RiskLevel | undefined | null,
+  probability: number | null | undefined,
+): string | null {
+  if (!getRiskVisual(level).showsProbability || probability == null) return null;
+  return `${(probability * 100).toFixed(0)}%`;
+}
